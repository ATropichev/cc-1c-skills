{
  "name": "Списки значений параметров: краткая запись через запятую, «auto» при поэлементном совпадении, явный список — объектной формой; nil в списке, большие числа, строки-ключевые слова и строки вида ссылки у параметра данных, ключевое слово в параметре схемы — кратко (#119); тип из пространства имён не из корня (xmlns на узле) — valueType {uri, name}, в отборе и в параметре данных; значение-период в отборе — объектом {variant[, date | startDate, endDate]}, не текстом узлов; StandardBeginningDate Custom с нулевой датой — с date (иначе станет StandardPeriod); вариант Month — краткой записью; правая часть у filled, если есть в XML, сохраняется (без неё — краткая запись); строка вида ссылки/числа в отборе — с valueType xs:string; период у параметра, объявленного строкой, — объектом {variant}, и при имени в другом регистре; строки true и вида даты в отборе — с valueType xs:string; отрицательное число — краткой записью; список периодов в отборе — массивом объектов",
  "preRun": [
    {
      "script": "skd-compile/scripts/skd-compile",
      "input": {
        "dataSets": [{ "name": "Н", "query": "ВЫБРАТЬ 1 КАК А", "fields": ["А"] }],
        "parameters": [
          "Коды: string(10) = A, B, C",
          "Склады: string(30) = Основной, 'Склад, розница'",
          { "name": "Суммы", "type": "decimal(10,2)", "valueListAllowed": true, "value": [1, 2.5] },
          "Метка: string(20) = 'x, y'",
          "Большие: decimal(15,0) = 10000000000, 20000000000",
          { "name": "Слово", "type": "string(20)", "value": "LastMonth" },
          { "name": "Ссылка", "type": ["string(30)", "CatalogRef.Валюты"], "hidden": true },
          { "name": "Вид", "type": "string(10)", "hidden": true },
          { "name": "Начало", "type": "dateTime", "hidden": true },
          { "name": "Период", "type": "StandardPeriod", "value": "Month", "hidden": true },
          { "name": "Обозначение", "type": "string(10)", "hidden": true }
        ],
        "settingsVariants": [
          { "name": "Авто", "settings": { "structure": "details", "dataParameters": "auto" } },
          { "name": "Явный", "settings": { "structure": "details", "filter": [
            { "field": "А", "op": "=", "value": "Active", "valueType": { "uri": "http://v8.1c.ru/8.1/data/enterprise", "name": "AccountType" } },
            { "field": "А", "op": ">=", "value": { "variant": "BeginningOfThisMonth" } },
            { "field": "А", "op": "<", "value": { "variant": "Custom", "date": "2024-01-01T00:00:00" } },
            { "field": "А", "op": "=", "value": { "variant": "Custom", "startDate": "2024-01-01T00:00:00", "endDate": "2024-03-31T23:59:59" } },
            { "field": "А", "op": "filled", "value": { "variant": "Custom", "date": "0001-01-01T00:00:00" } },
            { "field": "А", "op": "=", "value": "Catalog.Валюты.Рубль", "valueType": "xs:string" },
            { "field": "А", "op": "<>", "value": "5", "valueType": "xs:string" },
            { "field": "А", "op": "<>", "value": "true", "valueType": "xs:string" },
            { "field": "А", "op": "<>", "value": "2024-01-01T00:00:00", "valueType": "xs:string" },
            "А > -5",
            { "field": "А", "op": "in", "value": [{ "variant": "Custom", "date": "2024-01-01T00:00:00" }, { "variant": "BeginningOfThisMonth" }] },
            "А notFilled"
          ], "dataParameters": [
            { "parameter": "Вид", "value": ["Active", "Passive"], "valueType": { "uri": "http://v8.1c.ru/8.1/data/enterprise", "name": "AccountType" } },
            { "parameter": "Начало", "value": { "variant": "Custom", "date": "0001-01-01T00:00:00" } },
            "Период = Month",
            { "parameter": "обозначение", "value": { "variant": "Today" } },
            "Коды = A, B @user",
            { "parameter": "Суммы", "value": [3, 4.75], "valueType": "decimal(10,2)" },
            "Метка = 'одна, с запятой' @user",
            { "parameter": "Склады", "value": ["Основной", null] },
            { "parameter": "Слово", "value": "true", "valueType": "xs:string" },
            { "parameter": "Ссылка", "value": "Справочник.Валюты", "valueType": "xs:string" }
          ] } }
        ]
      },
      "args": { "-DefinitionFile": "{inputFile}", "-OutputPath": "Template.xml" },
      "cwd": "{workDir}"
    }
  ],
  "params": { "templatePath": "Template.xml" },
  "outputPath": "decompiled.json",
  "expect": {
    "fileContains": { "file": "decompiled.json", "text": "\"dataParameters\": \"auto\"" }
  }
}
