{
  "name": "Ошибка: владельцы, движения, определяемый тип, состав подсистемы (и вложенной) и права роли ссылаются на объекты, которых нет в расширении; тип в общей форме — предупреждение",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "Catalog",
          "name": "Номенклатура"
        },
        {
          "type": "Catalog",
          "name": "Склады"
        },
        {
          "type": "AccumulationRegister",
          "name": "Остатки",
          "dimensions": [
            "Склад: String(20)"
          ],
          "resources": [
            "Количество: Number(15,3)"
          ]
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-NamePrefix": "Тест_",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "DataProcessor",
          "name": "Тест_Обр",
          "attributes": [
            "Склад: CatalogRef.Склады"
          ]
        },
        {
          "type": "Catalog",
          "name": "Тест_Спр",
          "owners": [
            "Catalog.Номенклатура"
          ]
        },
        {
          "type": "Document",
          "name": "Тест_Док",
          "registerRecords": [
            "AccumulationRegister.Остатки"
          ]
        },
        {
          "type": "DefinedType",
          "name": "Тест_ОТ",
          "valueTypes": [
            "CatalogRef.Номенклатура"
          ]
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}/cfe"
      }
    },
    {
      "script": "role-compile/scripts/role-compile",
      "input": {
        "name": "Тест_Роль",
        "objects": [
          "Catalog.Номенклатура: @view"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}/cfe"
      }
    },
    {
      "script": "subsystem-compile/scripts/subsystem-compile",
      "args": {
        "-Value": "{\"name\":\"Тест_Подс\",\"content\":[\"Catalog.Номенклатура\"]}",
        "-OutputDir": "{workDir}/cfe"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "CommonForm",
          "name": "Тест_ОФ"
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}/cfe"
      }
    },
    {
      "script": "form-compile/scripts/form-compile",
      "input": {
        "title": "Т",
        "elements": [
          {
            "input": "Скл",
            "path": "Скл"
          }
        ],
        "attributes": [
          {
            "name": "Скл",
            "type": "CatalogRef.Склады"
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputPath": "{workDir}/cfe/CommonForms/Тест_ОФ/Ext/Form.xml"
      }
    },
    {
      "script": "subsystem-compile/scripts/subsystem-compile",
      "args": {
        "-Value": "{\"name\":\"Тест_Вл\",\"content\":[\"Catalog.Склады\"]}",
        "-OutputDir": "{workDir}/cfe",
        "-Parent": "{workDir}/cfe/Subsystems/Тест_Подс.xml"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe"
  },
  "expectError": true,
  "noSnapshot": "негативный кейс: навык ничего не пишет, проверяется текст ошибки",
  "expect": {
    "stdoutContains": [
      "[ERROR] 19. Catalog.Тест_Спр: Owners ссылается на Catalog.Номенклатура, а его нет в расширении — ниже 8.3.25 не загрузится",
      "[ERROR] 19. Document.Тест_Док: RegisterRecords ссылается на AccumulationRegister.Остатки",
      "[ERROR] 19. DefinedType.Тест_ОТ: Type ссылается на Catalog.Номенклатура, а его нет в расширении — платформа расширение не загрузит",
      "[ERROR] 19. Subsystem.Тест_Подс: Content ссылается на Catalog.Номенклатура",
      "[ERROR] 19. Role.Тест_Роль: права на Catalog.Номенклатура, а его нет в расширении — платформа их выбросит",
      "[WARN]  19. DataProcessor.Тест_Обр: тип ссылается на Catalog.Склады",
      "[ERROR] 19. Subsystem.Тест_Подс/Subsystems/Тест_Вл.xml: Content ссылается на Catalog.Склады",
      "[WARN]  19. CommonForm.Тест_ОФ: тип ссылается на Catalog.Склады"
    ]
  }
}
