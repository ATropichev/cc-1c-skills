{
  "name": "Модуль создан перехватчиком — свойство помечено расширенным (2.20)",
  "setup": "empty-config-220",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonModule", "name": "ОбщийМодуль3", "properties": { "Server": true } },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "writeFile": {
        "path": "CommonModules/ОбщийМодуль3/Ext/Module.bsl",
        "content": "Процедура ОбновитьДанные(Отбор) Экспорт\n\tВозврат;\nКонецПроцедуры\n"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/cfe", "-ConfigPath": "{workDir}" }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "CommonModule.ОбщийМодуль3",
        "-Module": "None"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe",
    "modulePath": "CommonModule.ОбщийМодуль3",
    "methodName": "ОбновитьДанные",
    "interceptorType": "After"
  },
  "expect": {
    "stdoutContains": "&После(\"ОбновитьДанные\")",
    "fileContains": [
      {
        "file": "cfe/CommonModules/ОбщийМодуль3.xml",
        "text": ["<xr:Property>Module</xr:Property>", "<xr:State>Extended</xr:State>"]
      }
    ]
  }
}
