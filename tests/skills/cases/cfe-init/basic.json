{
  "name": "Пустое расширение",
  "params": {
    "name": "МоёРасширение",
    "outputDir": "cfe"
  },
  "validatePath": "cfe",
  "expect": {
    "files": [
      "cfe/Configuration.xml"
    ],
    "preserves": {
      "file": "Configuration.xml",
      "bom": true,
      "eol": "crlf",
      "encoding": "UTF-8",
      "finalNewline": false,
      "noCR13": true,
      "selfClose": "tight",
      "noEmptyPairs": true
    }
  }
}
