{
  "name": "Заимствование прочих контейнерных типов",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Report", "name": "ОстаткиТоваров" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "DocumentJournal", "name": "Складские" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Sequence", "name": "ПартионныйУчет" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "HTTPService", "name": "ОбменДанными" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "WebService", "name": "СервисОбмена" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "FilterCriterion", "name": "ПоКонтрагенту" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "SettingsStorage", "name": "ХранилищеОтчетов" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/ext", "-ConfigPath": "{workDir}" }
    }
  ],
  "params": {
    "extensionPath": "ext",
    "object": "Report.ОстаткиТоваров ;; DocumentJournal.Складские ;; Sequence.ПартионныйУчет ;; HTTPService.ОбменДанными ;; WebService.СервисОбмена ;; FilterCriterion.ПоКонтрагенту ;; SettingsStorage.ХранилищеОтчетов"
  }
}
