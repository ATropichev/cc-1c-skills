{
  "name": "Заимствование формы с основным реквизитом: RowPictureDataPath от Объект. сохраняется",
  "setup": "fixture:doc-form-commandset",
  "preRun": [
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/ext", "-ConfigPath": "{workDir}" }
    }
  ],
  "params": { "extensionPath": "ext", "object": "Document.Расход.Form.ФормаДокумента" },
  "args_extra": ["-BorrowMainAttribute", "Form"],
  "expect": {
    "fileContains": {
      "file": "ext/Documents/Расход/Forms/ФормаДокумента/Ext/Form.xml",
      "text": [
        "<RowPictureDataPath>Объект.Товары.ИндексКартинки</RowPictureDataPath>",
        "<ExcludedCommand>Post</ExcludedCommand>",
        "<AutoTime>DontUse</AutoTime>"
      ]
    },
    "fileNotContains": {
      "file": "ext/Documents/Расход/Forms/ФормаДокумента/Ext/Form.xml",
      "text": ["<ExcludedCommand>MoveUp</ExcludedCommand>", "<CommandInterface>"]
    }
  }
}
