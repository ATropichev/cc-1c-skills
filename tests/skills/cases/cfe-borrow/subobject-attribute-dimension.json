{
  "name": "Реквизит документа и измерение регистра по одному — своим видом, без остальных подобъектов",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "Catalog",
          "name": "Номенклатура"
        },
        {
          "type": "Document",
          "name": "ЗаказКлиента",
          "attributes": [
            "Комментарий: String(50)"
          ],
          "tabularSections": {
            "Товары": [
              "Номенклатура: CatalogRef.Номенклатура",
              "Количество: Number(15,3)"
            ]
          }
        },
        {
          "type": "InformationRegister",
          "name": "Цены",
          "dimensions": [
            "Номенклатура: CatalogRef.Номенклатура"
          ],
          "resources": [
            "Цена: Number(15,2)"
          ]
        },
        {
          "type": "ChartOfCharacteristicTypes",
          "name": "ВидыСубконто",
          "valueType": "String",
          "tabularSections": {
            "Строки": [
              "Значение: String(20)"
            ]
          }
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    }
  ],
  "params": {
    "extensionPath": "cfe",
    "object": "Document.ЗаказКлиента.Attribute.Комментарий ;; InformationRegister.Цены.Dimension.Номенклатура"
  },
  "expect": {
    "fileContains": [
      {
        "file": "cfe/Documents/ЗаказКлиента.xml",
        "text": [
          "<Name>Комментарий</Name>"
        ]
      },
      {
        "file": "cfe/InformationRegisters/Цены.xml",
        "text": [
          "<Dimension uuid=",
          "<Name>Номенклатура</Name>"
        ]
      }
    ],
    "fileNotContains": [
      {
        "file": "cfe/Documents/ЗаказКлиента.xml",
        "text": [
          "<TabularSection"
        ]
      },
      {
        "file": "cfe/InformationRegisters/Цены.xml",
        "text": [
          "<Resource"
        ]
      }
    ]
  }
}
