{
  "name": "Заимствование формы списка с ручным запросом: реквизиты из текста запроса тоже заимствуются",
  "setup": "fixture:main-attr-kinds",
  "preRun": [
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/ext", "-ConfigPath": "{workDir}" }
    }
  ],
  "params": { "extensionPath": "ext", "object": "Document.Расход.Form.ФормаСпискаЗапрос" },
  "args_extra": ["-BorrowMainAttribute", "Form"],
  "expect": {
    "fileContains": {
      "file": "ext/Documents/Расход.xml",
      "text": ["<Name>Комментарий</Name>", "<Name>Склад</Name>"]
    },
    "fileNotContains": {
      "file": "ext/Documents/Расход.xml",
      "text": "<Name>Товары</Name>"
    }
  }
}
