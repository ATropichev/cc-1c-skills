{
  "name": "Повторное заимствование с -Module сохраняет содержимое объекта",
  "setup": "fixture:main-attr-kinds",
  "preRun": [
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/cfe", "-ConfigPath": "{workDir}" }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Document.Расход.Form.ФормаДокумента",
        "-BorrowMainAttribute": "All"
      }
    }
  ],
  "params": { "extensionPath": "cfe" },
  "object": "Document.Расход",
  "args_extra": ["-Module", "ObjectModule"],
  "expect": {
    "fileContains": [
      {
        "file": "cfe/Documents/Расход.xml",
        "text": [
          "<Form>ФормаДокумента</Form>",
          "<TabularSection uuid=",
          "<Name>Товары</Name>",
          "<Name>Комментарий</Name>"
        ]
      }
    ]
  }
}
