{
  "name": "Экранирование пользовательских строк: расшифровка, параметр, имена, шрифт",
  "input": {
    "columns": 2,
    "fonts": { "особый": { "face": "Font \"A&B\" <x>", "size": 10 } },
    "styles": { "особый": { "font": "особый" } },
    "areas": [
      {
        "name": "Строка<1>",
        "rows": [
          { "cells": [
            { "col": 1, "text": "Скидка", "detail": "Скидка <> 0" },
            { "col": 2, "param": "Сумма<НДС>", "detail": "СтрНайти(Комментарий, \"&\") > 0" }
          ]},
          { "cells": [
            { "col": 1, "style": "особый", "text": "Буквально", "detail": "Сумма &lt; 0" },
            { "col": 2, "detail": "Количество >= 1" }
          ]}
        ]
      }
    ],
    "drawings": [
      { "type": "Rectangle", "name": "Рамка&<1>", "detail": "Количество < 10",
        "begin": { "row": 1, "col": 1 }, "end": { "row": 2, "col": 2 } }
    ]
  },
  "params": { "outputPath": "Template.xml" }
}
