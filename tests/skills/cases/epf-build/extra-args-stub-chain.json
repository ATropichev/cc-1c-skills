{
  "name": "Доп. аргументы уходят и во временную базу, и в сборку (fake platform)",
  "preRun": [
    { "writeFile": { "path": "fake.cmd", "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n" } },
    { "writeFile": { "path": "src/Обработка.xml", "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MetaDataObject xmlns=\"http://v8.1c.ru/8.3/MDClasses\"/>\n" } }
  ],
  "args_extra": ["-V8Path", "{workDir}\\fake.cmd",
                 "-SourceFile", "{workDir}\\src\\Обработка.xml",
                 "-OutputFile", "{workDir}\\build\\Обработка.epf",
                 "-AdditionalV8Arguments", "/UseHwLicenses+"],
  "runtimeOnly": "powershell",
  "expect": {
    "stdoutContains": [
      "ARGS: CREATEINFOBASE",
      "/DisableStartupDialogs /UseHwLicenses+",
      "ARGS: DESIGNER",
      "/LoadExternalDataProcessorOrReportFromFiles"
