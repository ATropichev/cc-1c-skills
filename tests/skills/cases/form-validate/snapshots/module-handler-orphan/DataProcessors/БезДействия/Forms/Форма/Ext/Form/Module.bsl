#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеПриИзменении(Элемент)
	ПодключитьОбработчикОжидания("ОбработчикОжиданияПоля", 1, Истина);
	ПодключитьОбработчикОжидания(Элемент.Имя + "ПослеПаузы", 0.1, Истина);
	Оповещение = Новый ОписаниеОповещения("ПослеВопроса", ЭтотОбъект);
	Элементы.Поле.УстановитьДействие("Очистка", "ПолеОчисткаДинамически");
	Команды.ЛокализованнаяКоманда.Действие = "КомандаДинамически";
	Вспомогательная();
	// Мертвая() — упоминание в комментарии не считается
КонецПроцедуры

#КонецОбласти

