{
  "name": "Форма набора записей регистра: создаётся, но основной не назначается — свойства нет",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "AccumulationRegister",
        "name": "ОстаткиТест",
        "dimensions": [
          "Товар: String(50)"
        ],
        "resources": [
          "Количество: Number(15,3)"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Document",
        "name": "ПриходТест",
        "registerRecords": [
          "AccumulationRegister.ОстаткиТест"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectPath": "AccumulationRegisters/ОстаткиТест.xml",
    "formName": "ФормаНабора"
  },
  "args_extra": [
    "-Purpose",
    "RecordSet"
  ],
  "validatePath": "AccumulationRegisters/ОстаткиТест/Forms/ФормаНабора",
  "expect": {
    "stdoutContains": "Основной не назначена"
  }
}
