{
  "name": "Произвольная форма: без главного реквизита и без назначения основной",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "ТоварыТест"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectPath": "Catalogs/ТоварыТест.xml",
    "formName": "ПроизвольнаяФорма"
  },
  "args_extra": [
    "-Purpose",
    "Custom"
  ],
  "validatePath": "Catalogs/ТоварыТест/Forms/ПроизвольнаяФорма",
  "expect": {
    "stdoutContains": "Основной не назначена"
  }
}
