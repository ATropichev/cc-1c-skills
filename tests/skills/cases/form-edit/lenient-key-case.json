{
  "name": "Прощающий ввод: регистр ключей операции",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "DataProcessor",
        "name": "РедРегистр"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/DataProcessors/РедРегистр.xml",
        "-FormName": "Форма"
      }
    }
  ],
  "params": {
    "formPath": "DataProcessors/РедРегистр/Forms/Форма/Ext/Form.xml"
  },
  "input": {
    "Operations": [
      {
        "Op": "add-attribute",
        "Name": "Рек",
        "Type": "String",
        "Length": 5
      }
    ]
  }
}
