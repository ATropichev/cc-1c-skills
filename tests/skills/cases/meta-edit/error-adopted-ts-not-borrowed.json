{
  "name": "Колонка в незаимствованную ТЧ заимствованного объекта: отказ с подсказкой заимствовать ТЧ через cfe-borrow",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "Catalog",
          "name": "Номенклатура"
        },
        {
          "type": "Document",
          "name": "ЗаказКлиента",
          "attributes": [
            "Комментарий: String(50)"
          ],
          "tabularSections": {
            "Товары": [
              "Номенклатура: CatalogRef.Номенклатура",
              "Количество: Number(15,3)"
            ]
          }
        },
        {
          "type": "InformationRegister",
          "name": "Цены",
          "dimensions": [
            "Номенклатура: CatalogRef.Номенклатура"
          ],
          "resources": [
            "Цена: Number(15,2)"
          ]
        },
        {
          "type": "ChartOfCharacteristicTypes",
          "name": "ВидыСубконто",
          "valueType": "String",
          "tabularSections": {
            "Строки": [
              "Значение: String(20)"
            ]
          }
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/cfe",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/cfe",
        "-ConfigPath": "{workDir}",
        "-Object": "Document.ЗаказКлиента"
      }
    }
  ],
  "params": {
    "objectPath": "cfe/Documents/ЗаказКлиента.xml",
    "extensionPath": "cfe"
  },
  "input": {
    "modify": {
      "tabularSections": {
        "Товары": {
          "add": [
            "Тест_Скидка: Number(15,2)"
          ]
        }
      }
    }
  },
  "expectError": "cfe-borrow -Object Document.ЗаказКлиента.TabularSection.Товары",
  "expect": {
    "fileNotContains": [
      {
        "file": "cfe/Documents/ЗаказКлиента.xml",
        "text": "Тест_Скидка"
      }
    ]
  }
}
