{
  "name": "Позитив: раскрытый лист совпал с явно заданным — одна запись, не дубль",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "HTTPService", "name": "ВнешнийAPI", "rootURL": "api",
        "urlTemplates": {
          "Заказы": { "template": "/orders", "methods": { "Получить": "GET", "Создать": "POST" } },
          "Версия": { "template": "/version", "methods": { "GET": "GET" } }
        }
      },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    }
  ],
  "input": {
    "name": "ДоступКAPI",
    "synonym": "Доступ к API",
    "objects": [
      "HTTPService.ВнешнийAPI.URLTemplate.Заказы.Method.Получить: Use",
      "HTTPService.ВнешнийAPI: Use"
    ]
  },
  "validatePath": "Roles/ДоступКAPI",
  "expect": {
    "files": [
      "Roles/ДоступКAPI.xml",
      "Roles/ДоступКAPI/Ext/Rights.xml"
    ]
  }
}
