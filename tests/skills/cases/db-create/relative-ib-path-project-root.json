{
  "name": "Относительный путь к базе — от корня проекта (каталог .v8-project.json), а не от рабочего каталога",
  "fakePlatform": { "log": "" },
  "preRun": [
    { "writeFile": { "path": ".v8-project.json", "content": { "databases": [] } } }
